    "Connect a microphone or headset, or choose an input device in System Settings › Sound, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe ein Mikrofon oder Headset an oder wähle ein Eingabegerät unter Systemeinstellungen › Ton und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un micrófono o unos auriculares, o elige un dispositivo de entrada en Ajustes del Sistema › Sonido, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez un micro ou un casque, ou choisissez un périphérique d’entrée dans Réglages Système › Son, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクまたはヘッドセットを接続するか、システム設定 › サウンド で入力デバイスを選んでから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크나 헤드셋을 연결하거나 시스템 설정 › 사운드에서 입력 기기를 선택한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um microfone ou fone de ouvido, ou escolha um dispositivo de entrada em Ajustes do Sistema › Som, e tente novamente."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請連接麥克風或耳機，或在「系統設定 › 聲音」中選擇輸入裝置，然後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接麦克风或耳机，或在“系统设置 › 声音”中选择输入设备，然后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連接麥克風或耳機，或在「系統設定 › 聲音」中選擇輸入裝置，然後再試。"
          }
        }
      }
    },
