    "iCloud sync is off. Sign in to iCloud in Settings to sync recordings across devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung ist aus. Melde dich in den Einstellungen bei iCloud an, um Aufnahmen zwischen Geräten zu synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está desactivada. Inicia sesión en iCloud en Ajustes para sincronizar las grabaciones entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchro iCloud est désactivée. Connectez-vous à iCloud dans Réglages pour synchroniser les enregistrements entre vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期はオフです。デバイス間で録音を同期するには、設定で iCloud にサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 꺼져 있습니다. 기기 간에 녹음을 동기화하려면 설정에서 iCloud에 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização do iCloud está desativada. Inicie sessão no iCloud em Ajustes para sincronizar as gravações entre dispositivos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步未開啟。在「設定」中登入 iCloud，即可在裝置間同步錄音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步未开启。在“设置”中登录 iCloud，即可在设备间同步录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步未開啟。在「設定」中登入 iCloud，即可在裝置間同步錄音。"
          }
        }
      }
    },
