        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のその時刻は過ぎているため、録音は明日の %@ に停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 그 시각은 이미 지났으므로 녹음은 내일 %@에 중지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse horário já passou hoje, então a gravação para amanhã às %@."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的這個時間已經過了，錄音會在明天 %@ 停止。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
