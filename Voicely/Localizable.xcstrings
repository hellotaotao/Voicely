    "Stop recording, then quit and reopen Voicely to switch the language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die Aufnahme, dann beende Voicely und öffne es erneut, um die Sprache zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén la grabación y luego cierra y vuelve a abrir Voicely para cambiar el idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez l’enregistrement, puis quittez et rouvrez Voicely pour changer de langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を切り替えるには、録音を停止してから Voicely を終了し、もう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어를 바꾸려면 녹음을 중지한 후 Voicely를 종료하고 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare a gravação e depois encerre e abra o Voicely de novo para trocar o idioma."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先停止錄音，再結束並重新開啟 Voicely 即可切換語言。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先停止录音，再退出并重新打开 Voicely 即可切换语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先停止錄音，再結束並重新開啟 Voicely 即可切換語言。"
          }
        }
      }
    },
