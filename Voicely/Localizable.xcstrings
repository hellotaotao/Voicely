    "Record the meeting.\nRead it when it ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm die Besprechung auf.\nLies sie, sobald sie endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba la reunión.\nLéela cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez la réunion.\nLisez-la dès qu’elle se termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議を録音。\n終わったらすぐ読める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 녹음하세요.\n끝나면 바로 읽을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave a reunião.\nLeia quando ela terminar."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "錄下會議，\n會後直接看文字。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录下会议，\n会后直接看文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄下會議，\n會後直接看文字。"
          }
        }
      }
    },
    "Recorded on another device, which transcribes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Gerät aufgenommen, das sie transkribiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabada en otro dispositivo, que se encarga de transcribirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur un autre appareil, qui le transcrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで録音され、そのデバイスが文字起こしします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 녹음되었으며, 그 기기에서 전사합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravada em outro dispositivo, que faz a transcrição."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一部裝置上錄製，由那部裝置轉寫。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台设备上录制，由那台设备转写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一部裝置上錄製，由那部裝置轉寫。"
          }
        }
      }
    },
    "Recorded on another device, which transcribes it. To transcribe it on this device instead, tap Transcribe Now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Gerät aufgenommen, das sie transkribiert. Um sie stattdessen auf diesem Gerät zu transkribieren, tippe auf „Jetzt transkribieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabada en otro dispositivo, que se encarga de transcribirla. Para transcribirla en este dispositivo, toca Transcribir ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur un autre appareil, qui le transcrit. Pour le transcrire plutôt sur cet appareil, touchez Transcrire maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで録音され、そのデバイスが文字起こしします。このデバイスで文字起こしするには「今すぐ文字起こし」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 녹음되었으며, 그 기기에서 전사합니다. 이 기기에서 전사하려면 지금 전사를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravada em outro dispositivo, que faz a transcrição. Para transcrever neste dispositivo, toque em Transcrever agora."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一部裝置上錄製，由那部裝置轉寫。想改在這部裝置上轉寫，請點「立即轉寫」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台设备上录制，由那台设备转写。想改在这台设备上转写，请点“立即转写”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一部裝置上錄製，由那部裝置轉寫。想改在這部裝置上轉寫，請點「立即轉寫」。"
          }
        }
