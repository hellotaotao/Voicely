    "%lld more ahead of it in the transcription queue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld davor in der Transkriptionswarteschlange."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld más por delante en la cola de transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore %lld avant elle dans la file de transcription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしの順番待ちで、前にあと %lld 件あります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사 대기열에서 앞에 %lld개가 더 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há mais %lld à frente na fila de transcrição."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "轉寫佇列裡它前面還有 %lld 則。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写队列里它前面还有 %lld 条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉寫佇列裡它前面還有 %lld 則。"
          }
        }
      }
    },
