    "%@ The new text replaces the current transcript.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Der neue Text ersetzt das aktuelle Transkript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ El texto nuevo reemplaza la transcripción actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Le nouveau texte remplace la transcription actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 新しいテキストが現在の文字起こしと置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 새 텍스트가 현재 전사본을 대체합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O novo texto substitui a transcrição atual."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 新文字會取代目前的文字稿。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 新文字会替换当前文字稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 新文字會取代目前的逐字稿。"
          }
        }
