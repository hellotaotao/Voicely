        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모는 전사 대기열에서 기다리는 중이며, 이 기기에서 작업이 시작되면 진행 상황 표시로 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota está na fila de transcrição e vai mostrar o progresso ao vivo quando a tarefa começar neste dispositivo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這則錄音正在轉寫佇列裡等待，本機開始處理後會顯示即時進度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条录音正在转写队列里等待，本机开始处理后会显示实时进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則錄音正在轉寫佇列裡等待，本機開始處理後會顯示即時進度。"
          }
        }
      }
    },
    "This recording is currently being transcribed elsewhere. The transcript will appear here after sync finishes.": {
      "localizations": {
        "de": {
