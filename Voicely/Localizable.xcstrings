    "%@ was saved as scheduled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde wie geplant gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se guardó según lo programado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été enregistré comme prévu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は予定どおり保存されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 예정대로 저장되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi salvo conforme programado."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已按排定時間儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已按计划保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已按排定時間儲存。"
          }
        }
      }
    },
    "%@ will stop and be saved in %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird in %2$@ beendet und gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detendrá y se guardará en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s’arrêtera et sera enregistré dans %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ 後に停止して保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@ 후에 중지되고 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai parar e ser salvo em %2$@."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」將在 %2$@後停止並儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”将在 %2$@后停止并保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」將在 %2$@後停止並儲存。"
          }
        }
      }
    },
