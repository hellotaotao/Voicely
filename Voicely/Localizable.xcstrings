    "Could not save this attempt separately; its recovery checkpoint has been kept. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Versuch konnte nicht separat gesichert werden; sein Wiederherstellungspunkt bleibt erhalten. %@"
          }
        },
        "es": {
          "stringUnit": {
