    "Transcription paused by iOS. Saved progress resumes when you return to the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription von iOS pausiert. Der gesicherte Fortschritt läuft weiter, wenn du zur App zurückkehrst."
          }
        },
        "es": {
          "stringUnit": {
