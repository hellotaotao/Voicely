    "This note is waiting in the transcription queue and will switch to live progress once the local task starts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz wartet in der Transkriptionswarteschlange und zeigt den Live-Fortschritt, sobald die Aufgabe auf diesem Gerät startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota está en la cola de transcripción y mostrará el progreso en directo cuando empiece la tarea en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note attend dans la file de transcription et affichera la progression en direct dès que la tâche locale démarre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモは文字起こしの順番待ちです。このデバイスでの処理が始まると進行状況の表示に切り替わります。"
          }
