    "Audio file is missing from this device. Restore the audio or import it again to retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei fehlt auf diesem Gerät. Stelle das Audio wieder her oder importiere es erneut, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el archivo de audio en este dispositivo. Restaura el audio o vuelve a importarlo para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier audio est absent de cet appareil. Restaurez l’audio ou importez-le à nouveau pour réessayer."
