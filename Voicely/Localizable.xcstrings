    "New transcript, still in progress. The current one is kept until this finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Transkript, noch in Arbeit. Das aktuelle bleibt, bis dieses fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueva transcripción, aún en curso. La actual se conserva hasta que esta termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle transcription, encore en cours. L’actuelle est conservée jusqu’à la fin de celle-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい文字起こし(進行中)。完了するまで現在のものは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 전사본(진행 중)입니다. 완료될 때까지 현재 전사본이 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova transcrição, ainda em andamento. A atual é mantida até esta terminar."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "新的文字稿還在進行中。完成前會保留目前這份。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
