        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 오디오 파일이 없습니다. 오디오를 복원하거나 다시 가져온 후 재시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de áudio não está neste dispositivo. Restaure o áudio ou importe-o de novo para tentar novamente."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置上找不到音訊檔。請復原音訊或重新匯入後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
