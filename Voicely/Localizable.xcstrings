    "Transcription did not finish successfully. Retained text may be incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription wurde nicht erfolgreich beendet. Der erhaltene Text ist möglicherweise unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción no terminó correctamente. El texto conservado puede estar incompleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription ne s’est pas terminée correctement. Le texte conservé peut être incomplet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしは正常に完了しませんでした。残っているテキストは不完全な可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사가 정상적으로 완료되지 않았습니다. 남아 있는 텍스트가 불완전할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição não terminou corretamente. O texto mantido pode estar incompleto."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "轉寫沒有順利完成，保留下來的文字可能不完整。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写没有顺利完成，保留下来的文字可能不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
