    "Could not preserve the previous attempt. Retry was not started; saved progress is unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Versuch konnte nicht erhalten werden. Der neue Versuch wurde nicht gestartet; der gesicherte Fortschritt ist unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conservar el intento anterior. No se inició el reintento; el progreso guardado no cambió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de conserver la tentative précédente. La nouvelle tentative n’a pas été lancée ; la progression enregistrée est inchangée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の試行を保持できませんでした。再試行は開始していません。保存済みの進行状況は変わっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 시도를 보존하지 못했습니다. 재시도를 시작하지 않았으며 저장된 진행 상황은 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preservar a tentativa anterior. A nova tentativa não foi iniciada; o progresso salvo não mudou."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保留上一次的結果，所以沒有開始重試；已儲存的進度沒有變動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保留上一次的结果，所以没有开始重试；已保存的进度没有变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保留上一次的結果，所以沒有開始重試；已儲存的進度沒有變動。"
          }
        }
      }
    },
    "Could not read audio duration. The previous transcript and audio have been kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodauer konnte nicht gelesen werden. Das bisherige Transkript und das Audio bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la duración del audio. Se conservaron la transcripción y el audio anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la durée de l’audio. La transcription et l’audio précédents ont été conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の長さを読み取れませんでした。以前の文字起こしと音声はそのまま残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 길이를 읽을 수 없습니다. 이전 전사본과 오디오는 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a duração do áudio. A transcrição e o áudio anteriores foram mantidos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取音訊長度。原本的文字稿和音訊都已保留。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取音频时长。原来的文字稿和音频都已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取音訊長度。原本的逐字稿和音訊都已保留。"
          }
        }
      }
    },
    "Could not save the paused state. Keep the app open. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pausenzustand konnte nicht gesichert werden. Lass die App geöffnet. %@"
