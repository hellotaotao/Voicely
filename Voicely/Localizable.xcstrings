    "You can have up to %lld folders. Short names fit the folder bar best.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu %lld Ordner haben. Kurze Namen passen am besten in die Ordnerleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes tener hasta %lld carpetas. Los nombres cortos caben mejor en la barra de carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez avoir jusqu’à %lld dossiers. Les noms courts tiennent mieux dans la barre des dossiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは最大 %lld 個まで作成できます。短い名前がフォルダバーに収まりやすいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 최대 %lld개까지 만들 수 있습니다. 짧은 이름이 폴더 막대에 가장 잘 맞습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ter até %lld pastas. Nomes curtos cabem melhor na barra de pastas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可以建立 %lld 個資料夾。名稱短一點，在資料夾列裡顯示得最好。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可以建 %lld 个文件夹。名字短一点，在文件夹栏里显示得最好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可以建立 %lld 個資料夾。名稱短一點，在資料夾列裡顯示得最好。"
          }
        }
      }
    },
