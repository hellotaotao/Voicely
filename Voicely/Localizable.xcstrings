    "Its %lld recordings stay, just outside any folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine %lld Aufnahmen bleiben erhalten, nur außerhalb eines Ordners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus %lld grabaciones se conservan, solo que fuera de cualquier carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses %lld enregistrements sont conservés, simplement hors de tout dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の録音は残り、フォルダの外に移ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 %lld개는 그대로 남고 폴더 밖으로 옮겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %lld gravações dela continuam, só que fora de qualquer pasta."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裡面的 %lld 則錄音會保留，只是不再屬於任何資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里面的 %lld 条录音会保留，只是不再属于任何文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裡面的 %lld 則錄音會保留，只是不再屬於任何資料夾。"
          }
        }
      }
    },
