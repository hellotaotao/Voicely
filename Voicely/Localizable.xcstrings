    "Recording could not be finalized. Please check the saved audio before retrying.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht abgeschlossen werden. Prüfe das gesicherte Audio, bevor du es erneut versuchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo finalizar la grabación. Revisa el audio guardado antes de reintentar."
