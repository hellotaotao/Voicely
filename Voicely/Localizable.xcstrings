    "“%@” is transcribing, then %lld more ahead of it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird transkribiert, danach sind noch %lld davor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está transcribiendo «%@» y luego quedan %lld más por delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est en cours de transcription, puis encore %lld avant celui-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を文字起こし中です。そのあと、この録音の前にまだ %lld 件あります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 전사하는 중이며, 그다음 이 녹음 앞에 %lld개가 더 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está sendo transcrita e depois ainda há %lld à frente."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在轉寫「%1$@」，之後前面還有 %2$lld 則。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在转写“%1$@”，之后前面还有 %2$lld 条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在轉寫「%1$@」，之後前面還有 %2$lld 則。"
          }
        }
      }
    }
  },
