    "Background execution is unavailable. Keep the app open; saved progress resumes when you return.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführung im Hintergrund ist nicht verfügbar. Lass die App geöffnet; der gesicherte Fortschritt wird fortgesetzt, wenn du zurückkommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución en segundo plano no está disponible. Mantén la app abierta; el progreso guardado se reanuda cuando vuelvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exécution en arrière-plan n’est pas disponible. Gardez l’app ouverte ; la progression enregistrée reprendra à votre retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド実行を利用できません。アプリを開いたままにしてください。戻ると保存済みの進行状況から再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 실행을 사용할 수 없습니다. 앱을 열어 두세요. 돌아오면 저장된 진행 상황부터 다시 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução em segundo plano não está disponível. Mantenha o app aberto; o progresso salvo continua quando você voltar."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在背景執行。請保持 App 開啟；回來後會從已儲存的進度繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在后台运行。请保持 App 打开；回来后会从已保存的进度继续。"
          }
        },
