    "That time has passed today, so the recording stops tomorrow at %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhrzeit ist heute schon vorbei, daher endet die Aufnahme morgen um %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa hora ya pasó hoy, así que la grabación se detendrá mañana a las %@."
