          "stringUnit": {
            "state": "translated",
            "value": "新的逐字稿還在進行中。完成前會保留目前這份。"
          }
        }
      }
    },
    "Next in line. It starts as soon as “%@” finishes.": {
      "localizations": {
        "de": {
