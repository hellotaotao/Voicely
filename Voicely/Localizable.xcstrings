    "Δ local %lld / iCloud %lld — syncing or mismatch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ lokal %lld / iCloud %lld – Synchronisierung läuft oder Abweichung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ local %lld / iCloud %lld: sincronizando o no coinciden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ local %lld / iCloud %lld — synchro en cours ou écart"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ ローカル %lld / iCloud %lld — 同期中または不一致"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ 로컬 %lld / iCloud %lld — 동기화 중이거나 불일치"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ local %lld / iCloud %lld — sincronizando ou diferente"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "差異：本機 %1$lld / iCloud %2$lld — 同步中或不一致"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差异：本机 %1$lld / iCloud %2$lld — 同步中或不一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
