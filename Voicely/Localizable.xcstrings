    "An incoming call or another app interrupted recording. What you recorded so far has been saved. Start a new recording to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eingehender Anruf oder eine andere App hat die Aufnahme unterbrochen. Das bisher Aufgenommene wurde gesichert. Starte eine neue Aufnahme, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una llamada entrante u otra app interrumpió la grabación. Lo grabado hasta ahora se guardó. Inicia una nueva grabación para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appel entrant ou une autre app a interrompu l’enregistrement. Ce qui a été enregistré jusqu’ici est conservé. Lancez un nouvel enregistrement pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着信または他のアプリによって録音が中断されました。ここまでの録音は保存されています。続けるには新しい録音を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸려 온 전화나 다른 앱 때문에 녹음이 중단되었습니다. 지금까지 녹음한 내용은 저장되었습니다. 계속하려면 새 녹음을 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ligação recebida ou outro app interrompeu a gravação. O que foi gravado até agora foi salvo. Inicie uma nova gravação para continuar."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "來電或其他 App 中斷了錄音。已錄的部分已經儲存，開始新的錄音即可繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来电或其他 App 打断了录音。已录的部分已经保存，开始新的录音即可继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來電或其他 App 中斷了錄音。已錄的部分已經儲存，開始新的錄音即可繼續。"
          }
        }
      }
    },
