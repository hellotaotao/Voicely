    "Pauses or resumes the active Voicely recording from the Live Activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert die laufende Voicely-Aufnahme über die Live-Aktivität oder setzt sie fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o reanuda la grabación activa de Voicely desde la Actividad en Vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause ou reprend l’enregistrement Voicely en cours depuis l’activité en direct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティから Voicely の録音を一時停止または再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 현황에서 진행 중인 Voicely 녹음을 일시 정지하거나 재개합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa ou retoma a gravação ativa do Voicely pela Atividade ao Vivo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在即時動態中暫停或繼續進行中的 Voicely 錄音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在实时活动中暂停或继续正在进行的 Voicely 录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在即時動態中暫停或繼續進行中的 Voicely 錄音。"
          }
        }
      }
    },
